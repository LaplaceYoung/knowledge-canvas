{
  "manifest_version": 3,
  "name": "Knowledge Canvas Bridge",
  "version": "0.3.1",
  "description": "Connects Knowledge Canvas Web nodes to real ChatGPT, Claude, Gemini, Grok, DeepSeek, Doubao, Qwen, and Kimi tabs for in-canvas prompting and controls without reading cookies.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://www.qwen.com/*",
    "https://qwen.com/*",
    "https://chat.qwen.ai/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://www.qwen.com/*",
        "https://qwen.com/*",
        "https://chat.qwen.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "http://localhost:4173/*",
      "http://127.0.0.1:4173/*"
    ]
  },
  "action": {
    "default_title": "Knowledge Canvas Bridge"
  }
}
