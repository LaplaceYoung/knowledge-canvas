# Optional server-side PaddleOCR configuration.
# Browser-entered credentials in OCR settings take precedence.
PADDLEOCR_ACCESS_TOKEN=
# Official API base. Override only for an approved proxy or local testing.
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com

# Optional local ACP agent probe. Commands are configured only on the server,
# never submitted by the browser.
KC_ACP_COMMAND=
KC_ACP_ARGS=[]
KC_ACP_CWD=
